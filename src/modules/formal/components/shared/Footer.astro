---
import { Icon } from "astro-icon/components"
import { Mail } from "lucide-react"

import { siteInfo } from "@/config/const/site-info"

import type { LanguageData } from "@/config/types/language"

type Props = {
  t: LanguageData
}

const { t } = Astro.props
---

<footer class="footer-shell mt-20 py-6 sm:py-8">
  <div class="container-width">
    <div class="flex flex-col items-center gap-4 sm:gap-6">
      <div class="text-center">
        <h3 class="footer-name">
          {siteInfo.authorNameAndSurname}
        </h3>
        <p class="muted-text text-xs sm:text-sm">
          {t.hero.title}
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a
          href={siteInfo.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="github"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={siteInfo.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="linkedin"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={siteInfo.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="x"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={`mailto:${siteInfo.email}`}
          class="social-link p-2"
        >
          <Mail className="size-4 sm:h-5 sm:w-5" />
        </a>
      </div>

      <div class="faint-text text-center text-xs">
        <p>&copy; {t.footer.rights}</p>
      </div>
    </div>
  </div>
</footer>
