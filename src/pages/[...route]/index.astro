---
import type { GetStaticPaths } from "astro"

import Layout from "@/layouts/Layout.astro"
import Hero from "@/features/landing/sections/Hero.astro"
import About from "@/features/landing/sections/About.astro"
import Projects from "@/features/landing/sections/Projects.astro"
import Blog from "@/features/blog/sections/Blog.astro"
import Contact from "@/features/landing/sections/Contact.astro"

import { getRouteParams } from "@/libs/route-params"

export const getStaticPaths = (() => getRouteParams()) satisfies GetStaticPaths
---

<Layout>
  <Hero />
  <About />
  <Projects />
  <Blog />
  <Contact />
</Layout>
