---
import { getRelativeLocaleUrl } from "astro:i18n"

import { Badge } from "@/components/ui/badge"
import { Card } from "@/components/ui/card"

import { LinkIcon } from "lucide-react"

import { siteInfo } from "@/const/site-info"
import type { LanguageData } from "@/types/language"

type Props = {
  t: LanguageData
}

const { t } = Astro.props
const currentLang = Astro.currentLocale || "es"
---

<section
  id="about"
  class="compact-section space-y-14 pt-0 sm:space-y-16 sm:pt-5"
>
  <!-- Bio -->
  <div class="container-width">
    <Badge className="mb-3">
      {t.about.badge}
    </Badge>

    <h2 class="section-initial-title">
      {t.about.title}
    </h2>

    <div
      class="text-muted-foreground mb-8 space-y-3 text-sm sm:space-y-4 sm:text-base"
    >
      <p>{t.about.description1}</p>
      <p>{t.about.description2}</p>
    </div>
  </div>

  <!-- Education -->
  <div class="container-width pt-14 sm:pt-16">
    <div class="mb-4">
      <div>
        <Badge className="mb-3">
          {t.about.education.title}
        </Badge>

        <div class="flex items-center justify-between">
          <h2 class="section-initial-title mb-0">
            {t.about.education.heading}
          </h2>

          <a
            href={getRelativeLocaleUrl(currentLang, "/certificates")}
            class="text-muted-foreground inline-flex shrink-0 items-center gap-x-1 pt-1 text-xs hover:underline sm:text-sm"
          >
            {t.certificatesPage.btnToRedirect}
            <LinkIcon className="size-3" />
          </a>
        </div>
      </div>
    </div>

    <div
      class="divide-border mb-6 grid grid-cols-3 divide-x rounded-lg border text-center shadow-sm"
    >
      <div class="p-4">
        <div class="text-xl font-bold sm:text-2xl">
          {siteInfo.certificates.totalCourses}
        </div>
        <div
          class="text-muted-foreground mt-1 text-[11px] font-semibold tracking-wide uppercase sm:text-xs"
        >
          {t.certificatesPage.pageData.coursesCompleted}
        </div>
      </div>
      <div class="p-4">
        <div class="text-xl font-bold sm:text-2xl">
          {siteInfo.certificates.totalHours}+
        </div>
        <div
          class="text-muted-foreground mt-1 text-[11px] font-semibold tracking-wide uppercase sm:text-xs"
        >
          {t.certificatesPage.pageData.hoursCompleted}
        </div>
      </div>
      <div class="p-4">
        <div class="text-xl font-bold sm:text-2xl">
          {siteInfo.certificates.certifications}
        </div>
        <div
          class="text-muted-foreground mt-1 text-[11px] font-semibold tracking-wide uppercase sm:text-xs"
        >
          {t.certificatesPage.pageData.certificatesEarned}
        </div>
      </div>
    </div>

    <div class="relative space-y-4 pl-6">
      <div class="bg-border absolute top-1.5 bottom-1.5 left-1.25 w-px"></div>

      {
        t.about.education.educations.map((item) => (
          <div class="relative">
            <span class="border-foreground bg-background absolute top-1/2 -left-6 size-2.5 -translate-y-1/2 rounded-full border-2" />

            <Card className="p-4 sm:p-5">
              <div class="flex items-center justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <img
                    src={item.logo}
                    alt={`Logo ${item.academy}`}
                    loading="lazy"
                    class="size-10 shrink-0 rounded-full border object-cover"
                  />

                  <div class="min-w-0">
                    <h3 class="truncate text-sm font-semibold">
                      {item.academy}
                    </h3>
                    <p class="text-muted-foreground truncate text-xs sm:text-sm">
                      {item.degree}
                    </p>
                  </div>
                </div>

                <div class="flex shrink-0 flex-col items-end gap-1.5">
                  <Badge
                    variant="outline"
                    className="rounded-full"
                  >
                    {item.year}
                  </Badge>
                  <span class="text-muted-foreground text-[11px] font-medium whitespace-nowrap">
                    {item.courses.length} {t.about.education.coursesLabel}
                  </span>
                </div>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Skills -->
  <div class="container-width pt-14 sm:pt-16">
    <Badge className="mb-3">
      {t.about.skillsAndTechnologies.badge}
    </Badge>

    <h2 class="section-initial-title">
      {t.about.skillsAndTechnologies.title}
    </h2>

    <div class="border-t">
      {
        t.about.skillsAndTechnologies.skills.map(({ label, skills }) => (
          <div class="flex items-baseline justify-between gap-6 border-b py-4">
            <span class="text-muted-foreground w-24 shrink-0 text-[11px] font-semibold tracking-wide uppercase sm:w-28 sm:text-xs">
              {label}
            </span>
            <span class="text-right text-sm font-medium sm:text-base">
              {skills.join(" · ")}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
