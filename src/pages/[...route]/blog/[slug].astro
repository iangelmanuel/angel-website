---
import type { GetStaticPaths } from "astro"
import { getCollection } from "astro:content"

import Layout from "@/layouts/Layout.astro"
import JsonLd from "@/components/seo/JsonLd.astro"
import PostDetail from "@/features/blog/sections/PostDetail.astro"

import { getRouteParams } from "@/libs/route-params"
import { blogPostingLd } from "@/libs/seo"
import { SITE } from "@/config/site"
import { useI18n } from "@/i18n"

export const getStaticPaths = (async () => {
  const routeParams = getRouteParams()
  const posts = await getCollection("blog", (post) => !post.data.draft)

  return routeParams.flatMap(({ params }) => {
    const segments = (params.route ?? "").split("/").filter(Boolean)
    const lang = segments.includes("en") ? "en" : "es"

    return posts
      .filter((post) => post.id.split("/")[0] === lang)
      .map((post) => ({
        params: { ...params, slug: post.id.split("/").pop() },
        props: { post }
      }))
  })
}) satisfies GetStaticPaths

const { post } = Astro.props
const { lang } = useI18n(Astro)

const { title, description, image, publishDate, tags = [] } = post.data

const canonical = new URL(Astro.url.pathname, SITE.seo.url).href
const ogImage = image?.src ?? SITE.seo.image
const publishedTime = publishDate.toISOString()

const jsonLd = blogPostingLd({
  title,
  description,
  url: canonical,
  image: new URL(ogImage, SITE.seo.url).href,
  publishedTime,
  tags,
  lang
})
---

<Layout
  title={title}
  description={description}
  image={ogImage}
  imageWidth={image?.width}
  imageHeight={image?.height}
  imageAlt={title}
  keywords={[...tags, ...SITE.seo.keywords]}
  ogType="article"
  publishedTime={publishedTime}
  tags={tags}
>
  <JsonLd
    slot="jsonld"
    id="ld-blogposting"
    data={jsonLd}
  />

  <PostDetail post={post} />
</Layout>
