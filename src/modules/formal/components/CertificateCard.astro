---
import { Calendar, ExternalLink } from "lucide-react"

import { getCopy } from "@/modules/formal/i18n"
import { dateFormatter } from "@/config/lib/date-formatter"

import type { CollectionEntry } from "astro:content"

type Props = {
  cert: CollectionEntry<"certificates">
}

const { cert } = Astro.props
const copy = getCopy(Astro.currentLocale)
---

<article class="surface-card group h-auto overflow-hidden xl:h-[450px]">
  <header class="relative">
    <div class="media-frame media-frame-flush aspect-[4/3] overflow-hidden">
      <img
        src={cert.data.image}
        alt={`Certificación ${cert.data.title}`}
        class="object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    <div class="absolute top-3 right-3">
      <span class="chip chip-issuer">{cert.data.issuer}</span>
    </div>
  </header>

  <div class="px-4 pt-4">
    <div class="mb-3">
      <h4 class="card-title mb-1 line-clamp-2">
        {cert.data.title}
      </h4>
      <div class="card-meta flex items-center gap-1">
        <Calendar className="size-3" />
        <span>
          {
            dateFormatter(cert.data.issueDate!, {
              year: "numeric",
              month: "short",
              day: "numeric"
            })
          }
        </span>
      </div>
      {
        cert.data.credentialId && (
          <p class="card-meta mt-1">ID: {cert.data.credentialId}</p>
        )
      }
    </div>

    <div class="mb-3">
      <div class="flex flex-wrap gap-1">
        {
          cert.data.skills!.slice(0, 3).map((skill) => (
            <span class="chip">{skill}</span>
          ))
        }
        {
          cert.data.skills!.length > 3 && (
            <span class="chip chip-solid">+{cert.data.skills!.length - 3}</span>
          )
        }
      </div>
    </div>
  </div>

  <footer class="mt-auto px-4 pb-4">
    {
      cert.data.credentialUrl && (
        <a
          href={cert.data.credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary btn-sm mt-3 w-full lg:mt-0 lg:w-auto"
        >
          <ExternalLink className="size-3" />
          {copy.certificates.btnToVerify}
        </a>
      )
    }
  </footer>
</article>
