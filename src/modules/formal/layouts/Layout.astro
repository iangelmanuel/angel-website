---
import { ClientRouter } from "astro:transitions"

import Seo from "@/config/components/Seo.astro"
import ThemeScript from "@/config/components/ThemeScript.astro"
import { Toaster } from "@/config/components/ui/sonner"

import TopMenu from "../components/shared/TopMenu.astro"
import MainContent from "../components/shared/MainContent.astro"
import Footer from "../components/shared/Footer.astro"

import { siteInfo } from "@/config/const/site-info"

import type { LanguageData } from "@/config/types/language"

import "../styles/formal.css"

type Props = {
  t: LanguageData
  title: string
  description: string
  image?: string
}

const { t, title, description, image = siteInfo.seo.image } = Astro.props
const { currentLocale } = Astro
---

<ThemeScript />

<html
  lang={currentLocale}
  class="scroll-smooth"
>
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
    />

    <link
      rel="preload"
      href="/fonts/Nunito-VariableFont.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <ClientRouter />
  </head>

  <body>
    <TopMenu />

    <MainContent>
      <slot />
    </MainContent>

    <Toaster
      position="top-right"
      richColors
      duration={3000}
      client:visible
    />

    <Footer t={t} />
  </body>
</html>
