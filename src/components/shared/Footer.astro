---
import { Icon } from "astro-icon/components"
import { Mail } from "lucide-react"

import { getTranslations } from "@/i18n"
import { SITE } from "@/config/site"

const { hero, footer } = getTranslations(Astro.currentLocale)
---

<footer class="footer-shell mt-20 py-6 sm:py-8">
  <div class="container-width">
    <div class="flex flex-col items-center gap-4 sm:gap-6">
      <div class="text-center">
        <h3 class="footer-name">{SITE.info.name}</h3>
        <p class="muted-text text-xs sm:text-sm">{hero.title}</p>
      </div>

      <div class="flex items-center gap-6">
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="github"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="linkedin"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={SITE.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="x"
            class="size-4 sm:h-5 sm:w-5"
          />
        </a>
        <a
          href={`mailto:${SITE.contact.email}`}
          class="social-link p-2"
        >
          <Mail className="size-4 sm:h-5 sm:w-5" />
        </a>
      </div>

      <div class="faint-text text-center text-xs">
        <p>&copy; {footer.rights}</p>
      </div>
    </div>
  </div>
</footer>
