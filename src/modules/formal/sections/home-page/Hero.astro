---
import { ArrowDown, Download, Mail } from "lucide-react"
import { Icon } from "astro-icon/components"

import { getCopy } from "@/modules/formal/i18n"
import { siteInfo } from "@/config/const/site-info"

import type { LanguageData } from "@/config/types/language"

type Props = {
  t: LanguageData
}

const { t } = Astro.props
const currentLang = Astro.currentLocale || "es"
const copy = getCopy(currentLang)
---

<section
  class="compact-section m-0 flex items-center justify-center overflow-hidden pt-20 sm:h-screen sm:pt-24"
>
  <div
    class="container-width z-10 flex flex-col items-center gap-5 text-center sm:gap-8"
  >
    <div class="relative">
      <div class="avatar-frame mx-auto size-48 overflow-hidden sm:size-80">
        <img
          src="/img/profile-photo.webp"
          alt="Angel De La Torre profile photo"
          class="h-full w-full object-cover"
        />
      </div>
      <span
        class="avatar-badge absolute -right-2 -bottom-2 sm:-right-1 sm:bottom-5"
      >
        {t.hero.yearExp}
      </span>
    </div>

    <div class="order-1 max-w-2xl space-y-4 sm:order-2">
      <h1 class="hero-name">
        {t.hero.greeting}
        <span class="hero-name-accent">{siteInfo.authorName}</span>
        <span class="animate-wave inline-block">👋</span>
      </h1>

      <h2 class="hero-role">
        {t.hero.title}
      </h2>

      <p
        set:html={t.hero.description}
        class="body-text mx-auto max-w-xl"
      />

      <div
        class="flex flex-col items-center justify-center gap-3 pt-4 sm:flex-row sm:gap-4"
      >
        <a
          href="#projects"
          class="btn-primary w-full sm:w-auto"
        >
          <ArrowDown className="size-4" />
          {copy.hero.primaryBtn}
        </a>

        <button
          id="download-cv"
          type="button"
          data-lang={currentLang}
          class="btn-secondary w-full sm:w-auto"
        >
          <Download className="size-4" />
          {copy.hero.secondaryBtn}
        </button>
      </div>

      <div class="flex items-center justify-center gap-5 pt-4">
        <a
          href={siteInfo.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="github"
            class="h-5 w-5 sm:h-6 sm:w-6"
          />
          <span class="sr-only">GitHub</span>
        </a>
        <a
          href={siteInfo.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="linkedin"
            class="h-5 w-5 sm:h-6 sm:w-6"
          />
          <span class="sr-only">LinkedIn</span>
        </a>
        <a
          href={siteInfo.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link p-2"
        >
          <Icon
            name="x"
            class="h-5 w-5 sm:h-6 sm:w-6"
          />
          <span class="sr-only">Twitter</span>
        </a>
        <a
          href={`mailto:${siteInfo.email}`}
          class="social-link p-2"
        >
          <Mail className="h-5 w-5 sm:h-6 sm:w-6" />
          <span class="sr-only">Email</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { $ } from "@/config/lib/dom-selector"

  document.addEventListener("astro:page-load", () => {
    const $downloadBtn = $("#download-cv") as HTMLButtonElement
    const lang = $downloadBtn.dataset.lang || "es"

    const spanishCv = "cv-angel-dm.pdf"
    const englishCv = "cv-angel-dm-en.pdf"

    $downloadBtn.addEventListener("click", () => {
      const fileName = lang === "es" ? spanishCv : englishCv
      const fileUrl = `/docs/${fileName}`

      const link = document.createElement("a")
      link.href = fileUrl
      link.download = fileName
      document.body.appendChild(link)
      link.click()
      document.body.removeChild(link)
    })
  })
</script>
