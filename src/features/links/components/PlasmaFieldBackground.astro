---
---

<canvas
  id="plasma-field"
  aria-hidden="true"
></canvas>
<div
  class="scanlines"
  aria-hidden="true"
></div>
<div
  class="vignette"
  aria-hidden="true"
></div>

<style>
  #plasma-field {
    position: fixed;
    inset: 0;
    z-index: -3;
    height: 100%;
    width: 100%;
    pointer-events: none;
  }

  .scanlines {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in oklab, var(--foreground) 7%, transparent) 0 1px,
      transparent 1px 3px
    );
  }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 32%,
      var(--background) 94%
    );
  }
</style>

<script>
  const canvas = document.getElementById(
    "plasma-field"
  ) as HTMLCanvasElement | null
  const ctx = canvas?.getContext("2d", { alpha: true })

  if (canvas && ctx) {
    // Rampa ordenada de menor a mayor densidad visual
    const RAMP = Array.from(".:~;!+?=*%#&@")

    // Menos frames en pantallas chicas: ahorra batería sin que se note
    const FPS = window.innerWidth < 640 ? 14 : 20
    const FRAME_MS = 1000 / FPS
    const BLAST_LIFE = 1400
    const BLAST_WIDTH = 110
    const MAX_BLASTS = 3

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches

    type Blast = { x: number; y: number; start: number; reach: number }

    let palette = readPalette()
    let cell = 18
    let cols = 0
    let rows = 0
    let centerX = 0
    let centerY = 0
    let blasts: Blast[] = []
    let rafId = 0
    let lastFrame = 0
    let time = 0

    function readPalette() {
      const root = getComputedStyle(document.documentElement)
      const pick = (name: string, fallback: string) =>
        root.getPropertyValue(name).trim() || fallback

      return [
        pick("--dim", "#7c7c8a"),
        pick("--accent", "#3b82f6"),
        pick("--cyan", "#22d3ee"),
        pick("--green", "#22c55e"),
        pick("--orange", "#f59e0b")
      ]
    }

    function resize() {
      if (!canvas || !ctx) return

      const width = window.innerWidth
      const height = window.innerHeight
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5)

      cell = width < 640 ? 16 : 20

      canvas.width = Math.floor(width * dpr)
      canvas.height = Math.floor(height * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.font = `${cell - 4}px "Geist Pixel", "JetBrains Mono", monospace`
      ctx.textBaseline = "top"

      cols = Math.ceil(width / cell)
      rows = Math.ceil(height / cell)
      centerX = width / 2
      centerY = height / 2
    }

    function addBlast(x: number, y: number) {
      if (reduceMotion) return
      if (blasts.length >= MAX_BLASTS) blasts.shift()

      blasts.push({
        x,
        y,
        start: performance.now(),
        reach: Math.max(window.innerWidth, window.innerHeight) * 0.9
      })
    }

    function render(now: number) {
      if (!canvas || !ctx) return

      const width = window.innerWidth
      const height = window.innerHeight

      ctx.clearRect(0, 0, width, height)

      if (blasts.length) {
        blasts = blasts.filter((blast) => now - blast.start < BLAST_LIFE)
      }

      const buckets: number[][] = [[], [], [], [], []]

      for (let row = 0; row < rows; row++) {
        const y = row * cell
        const dyCenter = (y - centerY) * 0.05
        const dyCenterSq = dyCenter * dyCenter

        for (let col = 0; col < cols; col++) {
          const x = col * cell
          const dxCenter = (x - centerX) * 0.05
          const ripple = Math.sqrt(dxCenter * dxCenter + dyCenterSq)

          let value =
            Math.sin(x * 0.012 + time) +
            Math.sin(y * 0.018 - time * 0.7) +
            Math.sin((x + y) * 0.008 + time * 1.3) +
            Math.sin(ripple - time * 2.2) * 1.4

          for (let b = 0; b < blasts.length; b++) {
            const blast = blasts[b]
            const age = (now - blast.start) / BLAST_LIFE
            const dx = x - blast.x
            const dy = y - blast.y
            const distance = Math.sqrt(dx * dx + dy * dy)
            const delta = distance - age * blast.reach

            if (delta > -BLAST_WIDTH && delta < BLAST_WIDTH) {
              const shape = Math.cos(((delta / BLAST_WIDTH) * Math.PI) / 2)
              value += shape * shape * (1 - age) * 4.5
            }
          }

          const level = (value + 4.4) / 8.8

          if (level < 0.42) continue

          const rampIndex = Math.min(
            RAMP.length - 1,
            (((level - 0.42) / 0.58) * RAMP.length) | 0
          )

          const bucket = Math.min(4, ((rampIndex * 5) / RAMP.length) | 0)

          buckets[bucket].push(x, y, rampIndex)
        }
      }

      for (let b = 0; b < buckets.length; b++) {
        const items = buckets[b]

        if (!items.length) continue

        ctx.fillStyle = palette[b]
        ctx.globalAlpha = 0.25 + b * 0.16

        for (let i = 0; i < items.length; i += 3) {
          ctx.fillText(RAMP[items[i + 2]], items[i], items[i + 1])
        }
      }

      ctx.globalAlpha = 1
    }

    function loop(now: number) {
      rafId = requestAnimationFrame(loop)

      if (now - lastFrame < FRAME_MS) return

      lastFrame = now
      time += 0.07
      render(now)
    }

    function start() {
      if (rafId || reduceMotion) return
      lastFrame = performance.now()
      rafId = requestAnimationFrame(loop)
    }

    function stop() {
      cancelAnimationFrame(rafId)
      rafId = 0
    }

    let resizeTimer = 0

    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(resize, 150)
    })

    window.addEventListener(
      "pointerdown",
      (event) => addBlast(event.clientX, event.clientY),
      { passive: true }
    )

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop()
      else start()
    })

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        palette = readPalette()
      })

    resize()

    if (reduceMotion) render(performance.now())
    else start()
  }
</script>
