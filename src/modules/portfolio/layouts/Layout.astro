---
import { ClientRouter } from "astro:transitions"

import Seo from "@/config/components/Seo.astro"
import ThemeScript from "@/config/components/ThemeScript.astro"
import { Toaster } from "@/config/components/ui/sonner"

import TopMenu from "../components/shared/TopMenu.astro"
import MainContent from "../components/shared/MainContent.astro"
import Footer from "../components/shared/Footer.astro"

import { getDesign } from "@/config/lib/design"
import { siteInfo } from "@/config/const/site-info"

import "../styles/portfolio.css"

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image = siteInfo.seo.image } = Astro.props

const DESIGN = getDesign(Astro.url)
const { currentLocale } = Astro
---

<ThemeScript />

<html
  lang={currentLocale}
  data-design={DESIGN}
  class="scroll-smooth"
>
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
    />

    {
      DESIGN === "TERMINAL" ? (
        <Fragment>
          <link
            rel="preload"
            href="/fonts/geist-pixel.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
          />
          <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
          />
          <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin="anonymous"
          />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
          />
        </Fragment>
      ) : (
        <link
          rel="preload"
          href="/fonts/Nunito-VariableFont.woff2"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      )
    }

    <ClientRouter />
  </head>

  <body>
    <TopMenu />

    <MainContent>
      <slot />
    </MainContent>

    <Toaster
      position="top-right"
      richColors
      duration={3000}
      client:visible
    />

    <Footer />
  </body>
</html>
