---
import type { Design } from "@/types/i18n"

interface Props {
  design: Design
}

const { design } = Astro.props
---

{
  design === "TERMINAL" ? (
    <Fragment>
      <link
        rel="preload"
        href="/fonts/geist-pixel.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
      <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
      />
      <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin="anonymous"
      />
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      />
    </Fragment>
  ) : (
    <link
      rel="preload"
      href="/fonts/Nunito-VariableFont.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  )
}
