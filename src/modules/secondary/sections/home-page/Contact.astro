---
import { ContactForm } from "@/components/ContactForm"
import { Mail, MapPin, Phone } from "lucide-react"
import { siteInfo } from "@/const/site-info"
import type { LanguageData } from "@/types/language"
import { Badge } from "@/components/ui/badge"

type Props = {
  t: LanguageData
  currentLang: string
}

const { t, currentLang } = Astro.props
---

<section
  id="contact"
  class="compact-section"
>
  <div class="container-width mx-auto max-w-xl text-center">
    <Badge className="mb-3">
      {t.contact.badge}
    </Badge>

    <h2 class="section-title mb-3">{t.contact.title}</h2>

    <p
      class="text-muted-foreground mx-auto mb-10 max-w-sm text-sm sm:text-base"
    >
      {t.contact.lede}
    </p>

    <div class="text-left">
      <ContactForm
        t={t}
        currentLang={currentLang}
        client:only="react"
      />
    </div>

    <div
      class="text-muted-foreground mt-12 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 border-t pt-8 text-xs sm:text-sm"
    >
      <a
        href={`mailto:${siteInfo.email}`}
        class="hover:text-foreground inline-flex items-center gap-1.5 font-medium transition-colors"
      >
        <Mail className="size-3.5" />
        {siteInfo.email}
      </a>

      <span class="text-border px-1">·</span>

      <a
        href={`tel:${siteInfo.phone}`}
        class="hover:text-foreground inline-flex items-center gap-1.5 font-medium transition-colors"
      >
        <Phone className="size-3.5" />
        {siteInfo.phone}
      </a>

      <span class="text-border px-1">·</span>

      <span class="inline-flex items-center gap-1.5 font-medium">
        <MapPin className="size-3.5" />
        {siteInfo.location}
      </span>
    </div>
  </div>
</section>
