---
import { Globe } from "lucide-react"

import { useI18n } from "@/i18n"
import { getAlternateLocaleUrl } from "@/libs/alternate-url"

const { lang, design } = useI18n(Astro)

const linkToRedirect = getAlternateLocaleUrl(Astro.url.pathname, lang)
---

<a
  href={linkToRedirect}
  aria-label="Toggle Language"
  class="icon-btn mr-0 size-8 transition-transform duration-300 hover:scale-110 sm:size-10"
>
  {
    design === "TERMINAL" ? (
      <span class="lang-code">{lang === "es" ? "en" : "es"}</span>
    ) : (
      <Globe className="size-4 transition-all duration-300 sm:size-5" />
    )
  }
</a>
