---
import { getRelativeLocaleUrl } from "astro:i18n"

import AsideMobileMenu from "./AsideMobileMenu.astro"
import DesignToggle from "../DesignToggle.astro"
import ToggleLanguage from "../ToggleLanguage.astro"
import { ModeToggle } from "../ModeToggle"

import { SITE } from "@/config/site"
import { useI18n } from "@/i18n"
import { routes } from "@/const/routes"

const { t, lang, design } = useI18n(Astro)

const homeUrl = getRelativeLocaleUrl(lang, routes[design].home)

const navItems = t(SITE.navigation).map(({ name, href }) => ({
  label: name,
  href: href.startsWith("/") ? `${homeUrl}${href.slice(1)}` : href
}))
---

<nav
  id="top-menu"
  class="top-bar fixed top-0 right-0 left-0 z-50 opacity-100 transition-all duration-300"
>
  <section class="mx-auto max-w-3xl">
    <div class="relative flex h-16 items-center justify-between sm:h-20">
      <a
        href={homeUrl}
        class="brand mx-5 flex items-center gap-2 transition-transform duration-300 hover:scale-105 lg:mx-0"
      >
        <img
          src={SITE.seo.image}
          alt={t(SITE.seo.imageAlt)}
          class="logo-frame inline size-12 rounded-full border-2 border-solid border-gray-300 object-cover transition-all duration-300 dark:border-gray-700"
        />
      </a>

      <div
        class="absolute top-1/2 left-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center space-x-8 lg:flex lg:space-x-12"
      >
        {
          navItems.map(({ href, label }) => (
            <a
              href={href}
              class="nav-link group relative"
            >
              {label}
              <span class="nav-underline" />
            </a>
          ))
        }
      </div>

      <div
        class="flex items-center justify-center gap-2 px-5 sm:space-x-3 lg:px-0"
      >
        <DesignToggle />
        <ToggleLanguage />
        <ModeToggle client:load />
        <AsideMobileMenu navItems={navItems} />
      </div>
    </div>
  </section>
</nav>

<script>
  import { $ } from "@/libs/dom-selector"

  document.addEventListener("astro:page-load", () => {
    window.addEventListener("scroll", handleScroll, { passive: true })
  })

  let lastScrollTop = 0

  function handleScroll() {
    const $topMenu = $("#top-menu") as HTMLElement

    const { scrollY } = window

    if (scrollY > lastScrollTop) {
      $topMenu.classList.remove("top-bar-scrolled")
      $topMenu.classList.remove("opacity-100")
      $topMenu.classList.add("opacity-0")
    } else {
      $topMenu.classList.add("top-bar-scrolled")
      $topMenu.classList.remove("opacity-0")
      $topMenu.classList.add("opacity-100")
    }

    lastScrollTop = scrollY <= 0 ? 0 : scrollY
  }
</script>
