---
import type { GetStaticPaths } from "astro"

import Layout from "@/layouts/Layout.astro"
import Hero from "@/modules/portfolio/sections/certificates/Hero.astro"
import CertificatesGrid from "@/modules/portfolio/sections/certificates/CertificatesGrid.astro"

import { getRouteParams } from "@/libs/route-params"
import { getTranslations } from "@/i18n"

export const getStaticPaths = (() => getRouteParams()) satisfies GetStaticPaths

const { seo } = getTranslations(Astro.currentLocale)
---

<Layout
  title={seo.certificatesPage.title}
  description={seo.certificatesPage.description}
>
  <Hero />
  <CertificatesGrid />
</Layout>
