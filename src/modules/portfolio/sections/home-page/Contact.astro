---
import { Mail, MapPin, Phone } from "lucide-react"

import { ContactForm } from "../../components/ContactForm"

import { ui, useI18n } from "@/i18n"
import { SITE } from "@/config/site"

const { t, lang, design } = useI18n(Astro)
const contact = t(ui.contact)
---

<section
  id="contact"
  class="compact-section"
>
  <div class="container-width mx-auto max-w-xl text-center">
    <span class="section-badge">{contact.badge}</span>

    <h2 class="section-title mb-3">{contact.title}</h2>

    <p class="body-text mx-auto mb-10 max-w-sm">{contact.lede}</p>

    <div class="form-shell text-left">
      {
        design === "TERMINAL" && (
          <div class="form-shell-bar">
            <span class="form-shell-dot" />
            <span class="form-shell-dot" />
            <span class="form-shell-dot" />
            <span class="ml-1.5">{contact.windowTitle}</span>
          </div>
        )
      }

      <div class="form-shell-body">
        <ContactForm
          contact={contact}
          lang={lang}
          client:only="react"
        />
      </div>
    </div>

    <div
      class="rule-t mt-12 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 pt-8"
    >
      <a
        href={`mailto:${SITE.contact.email}`}
        class="contact-link"
      >
        <Mail className="size-3.5" />
        {SITE.contact.email}
      </a>

      <span class="contact-sep">·</span>

      <a
        href={`tel:${SITE.contact.whatsapp()}`}
        class="contact-link"
      >
        <Phone className="size-3.5" />
        {SITE.contact.phoneDisplay()}
      </a>

      <span class="contact-sep">·</span>

      <span class="contact-link contact-link-static">
        <MapPin className="size-3.5" />
        {SITE.location.display}
      </span>
    </div>
  </div>
</section>
