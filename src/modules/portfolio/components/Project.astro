---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"

import { Calendar, ExternalLink } from "lucide-react"

import { getTranslations } from "@/config/i18n"
import { getDesign } from "@/config/lib/design"
import { getCardAccent } from "../lib/card-accent"
import { dateFormatter } from "@/config/lib/date-formatter"

import type { CollectionEntry } from "astro:content"

type Props = {
  id: string
  index: number
  data: CollectionEntry<"projects">["data"]
}

const { id, index, data } = Astro.props

const DESIGN = getDesign(Astro.url)
const { projects } = getTranslations(Astro.currentLocale)

const slug = id.split("/").pop()
const accent = getCardAccent(index)
---

<article
  class="win-card group"
  style={`--card-color: var(--${accent})`}
>
  {
    DESIGN === "TERMINAL" && (
      <div class="win-card-bar">
        <div class="win-card-dots">
          <span class="win-card-dot" />
          <span class="win-card-dot" />
          <span class="win-card-dot" />
        </div>
        <span class="win-card-path">~/{slug}</span>
      </div>
    )
  }

  <div class="win-card-body">
    <header class="media-frame aspect-video overflow-hidden">
      <Image
        src={data.image}
        alt={`${data.title} Image`}
        width={800}
        height={450}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-115"
      />
    </header>

    <div class="mt-4 flex items-start gap-2">
      <h3 class="win-card-title min-w-0 flex-1">
        {DESIGN === "TERMINAL" && <span class="win-card-prompt">&gt;</span>}
        {data.title}
      </h3>

      {
        data.githubUrl.isPrivate ? (
          <span class="chip shrink-0">Private</span>
        ) : (
          <a
            href={data.githubUrl.url}
            target="_blank"
            rel="noopener noreferrer"
            class="chip chip-link shrink-0 gap-1"
          >
            <Icon
              name="github"
              size="1em"
            />
            <span>Public</span>
          </a>
        )
      }
    </div>

    <span class="card-meta flex items-center gap-1.5">
      <Calendar className="size-3.5" />
      {
        dateFormatter(data.publishDate, {
          day: "2-digit",
          month: "short",
          year: "numeric"
        })
      }
    </span>

    <p class="card-text mt-1.5 mb-3 line-clamp-2 text-start sm:mb-4">
      {data.description}
    </p>

    <div class="mb-3 flex flex-wrap gap-1.5 sm:mb-4 sm:gap-2">
      {data.technologies.map((tag) => <span class="chip chip-solid">{tag}</span>)}
    </div>

    <footer class="mt-auto flex items-center gap-2 sm:gap-3">
      <a
        href={data.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary btn-sm w-full"
      >
        <ExternalLink className="size-3" />
        {projects.demo[DESIGN]}
      </a>
    </footer>
  </div>
</article>
