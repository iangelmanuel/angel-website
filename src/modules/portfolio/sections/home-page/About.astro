---
import { getRelativeLocaleUrl } from "astro:i18n"

import { LinkIcon } from "lucide-react"

import { getTranslations } from "@/i18n"
import { getDesign } from "@/libs/design"
import { routes } from "@/const/routes"

const DESIGN = getDesign(Astro.url)
const currentLang = Astro.currentLocale || "es"
const { about, certificates } = getTranslations(currentLang)
---

<section
  id="about"
  class="compact-section space-y-14 pt-0 sm:space-y-16 sm:pt-5"
>
  <!-- Bio -->
  <div class="container-width">
    <span class="section-badge">{about.badge}</span>

    <h2 class="section-initial-title">{about.title[DESIGN]}</h2>

    <div class="body-text mb-8 space-y-3 sm:space-y-4">
      <p>{about.description1}</p>
      <p>{about.description2}</p>
    </div>
  </div>

  <!-- Education -->
  <div class="container-width pt-14 sm:pt-16">
    <div class="mb-4">
      <span class="section-badge">{about.education.badge}</span>

      <div class="flex items-center justify-between">
        <h2 class="section-initial-title mb-0">
          {about.education.title[DESIGN]}
        </h2>

        <a
          href={getRelativeLocaleUrl(currentLang, routes[DESIGN].certificates)}
          class="text-link inline-flex shrink-0 items-center gap-x-1 pt-1"
        >
          {about.education.btnToCertificates[DESIGN]}
          <LinkIcon className="size-3" />
        </a>
      </div>
    </div>

    <div class="stat-grid mb-6 grid grid-cols-3 text-center">
      <div class="p-4">
        <div class="stat-value">12</div>
        <div class="stat-label">{certificates.coursesCompleted}</div>
      </div>
      <div class="p-4">
        <div class="stat-value">300+</div>
        <div class="stat-label">{certificates.hoursCompleted}</div>
      </div>
      <div class="p-4">
        <div class="stat-value">12</div>
        <div class="stat-label">{certificates.certificatesEarned}</div>
      </div>
    </div>

    <div class="relative space-y-4 pl-6">
      <div class="timeline-rail absolute top-1.5 bottom-1.5 left-1.25"></div>

      {
        about.education.list.map((item) => (
          <div class="relative">
            <span class="timeline-dot absolute top-1/2 -left-6 -translate-y-1/2" />

            <article class="surface-card p-4 sm:p-5">
              <div class="flex items-center justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <img
                    src={item.logo}
                    alt={`Logo ${item.academy}`}
                    loading="lazy"
                    class="academy-logo size-10 shrink-0 object-cover"
                  />

                  <div class="min-w-0">
                    <h3 class="card-title truncate">{item.academy}</h3>
                    <p class="card-text truncate">{item.degree}</p>
                  </div>
                </div>

                <div class="flex shrink-0 flex-col items-end gap-1.5">
                  <span class="chip">{item.year}</span>
                  <span class="card-meta whitespace-nowrap">
                    {item.courses.length} {about.education.coursesLabel}
                  </span>
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Skills -->
  <div class="container-width pt-14 sm:pt-16">
    <span class="section-badge">{about.skills.badge}</span>

    <h2 class="section-initial-title">{about.skills.title[DESIGN]}</h2>

    <div class="rule-t">
      {
        about.skills.list.map(({ label, skills }) => (
          <div class="rule-b flex items-baseline justify-between gap-6 py-4">
            <span class="skill-label w-24 shrink-0 sm:w-28">{label}</span>
            <span class="skill-value text-right">{skills.join(" · ")}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
