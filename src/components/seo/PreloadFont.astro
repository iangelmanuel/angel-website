---
import type { Design } from "@/types/i18n"

interface Props {
  design: Design
}

const { design } = Astro.props
---

{
  design === "TERMINAL" ? (
    <Fragment>
      <link
        rel="preload"
        href="/fonts/geist-pixel.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
      <link
        rel="preload"
        href="/fonts/JetBrainsMono-Variable.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    </Fragment>
  ) : (
    <link
      rel="preload"
      href="/fonts/Nunito-VariableFont.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  )
}
