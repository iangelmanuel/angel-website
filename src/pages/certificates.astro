---
import Layout from "@/modules/pixel/layouts/Layout.astro"
import Hero from "@/modules/pixel/sections/certificates/Hero.astro"
import CertificatesGrid from "@/modules/pixel/sections/certificates/CertificatesGrid.astro"

import { getTranslations } from "@/config/i18n"

const currentLang = Astro.currentLocale || "es"
const t = getTranslations(currentLang)
---

<Layout
  t={t}
  title={t.seo.certificatesPage.title}
  description={t.seo.certificatesPage.description}
>
  <Hero t={t} />
  <CertificatesGrid />
</Layout>
