---
import { getCollection } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"

import { LinkIcon } from "lucide-react"

import EducationItem from "../components/EducationItem.astro"
import ExperienceItem from "../components/ExperienceItem.astro"

import { ui, useI18n } from "@/i18n"
import { routes } from "@/const/routes"

const { t, lang, design } = useI18n(Astro)
const about = t(ui.about)

const experienceCollection = await getCollection("experience", (entry) => {
  const [entryLang] = entry.id.split("/")
  return entryLang === lang
})

const educationCollection = await getCollection("education", (entry) => {
  const [entryLang] = entry.id.split("/")
  return entryLang === lang
})

const experienceList = experienceCollection.sort(
  (a, b) => a.data.order - b.data.order
)

const educationList = educationCollection.sort(
  (a, b) => a.data.order - b.data.order
)
---

<section
  id="about"
  class="compact-section space-y-8 pt-0 sm:pt-5"
>
  <!-- Bio -->
  <div class="container-width">
    <span class="section-badge">{about.badge}</span>

    <h2 class="section-initial-title">{about.title}</h2>

    <div class="body-text mb-8 space-y-3 sm:space-y-4">
      <p>{about.description1}</p>
      <p>{about.description2}</p>
    </div>
  </div>

  <!-- Experience -->
  <div class="container-width pt-14 sm:pt-16">
    <span class="section-badge">{about.experience.badge}</span>

    <h2 class="section-initial-title">{about.experience.title}</h2>

    <div class="space-y-6">
      {
        experienceList.map((item) => (
          <ExperienceItem
            item={item}
            isCurrent={item.data.isCurrent}
          />
        ))
      }
    </div>
  </div>

  <!-- Education -->
  <div class="container-width pt-14 sm:pt-16">
    <div class="mb-4">
      <span class="section-badge">{about.education.badge}</span>

      <div class="flex items-center justify-between">
        <h2 class="section-initial-title mb-0">
          {about.education.title}
        </h2>

        <a
          href={getRelativeLocaleUrl(lang, routes[design].certificates)}
          class="text-link inline-flex shrink-0 items-center gap-x-1 pt-1"
        >
          {about.education.btnToCertificates}
          <LinkIcon className="size-3" />
        </a>
      </div>
    </div>

    <div class="relative space-y-6 pl-6">
      <div class="timeline-rail absolute top-1.5 bottom-1.5 left-1.25"></div>

      {
        educationList.map((item) => (
          <div class="relative">
            <span class="timeline-dot absolute top-1/2 -left-6 -translate-y-1/2" />

            <EducationItem item={item} />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Skills -->
  <div class="container-width pt-14 sm:pt-16">
    <span class="section-badge">{about.skills.badge}</span>

    <h2 class="section-initial-title">{about.skills.title}</h2>

    <div class="rule-t">
      {
        about.skills.list.map(({ label, skills }) => (
          <div class="rule-b flex items-baseline justify-between gap-6 py-4">
            <span class="skill-label w-24 shrink-0 sm:w-28">{label}</span>
            <span class="skill-value text-right">{skills.join(" · ")}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
