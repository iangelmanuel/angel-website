---
import type { GetStaticPaths } from "astro"

import Layout from "@/layouts/Layout.astro"
import Hero from "@/modules/portfolio/sections/home-page/Hero.astro"
import About from "@/modules/portfolio/sections/home-page/About.astro"
import Projects from "@/modules/portfolio/sections/home-page/Projects.astro"
import Contact from "@/modules/portfolio/sections/home-page/Contact.astro"

import { getRouteParams } from "@/libs/route-params"
import { getTranslations } from "@/i18n"

export const getStaticPaths = (() => getRouteParams()) satisfies GetStaticPaths

const { seo } = getTranslations(Astro.currentLocale)
---

<Layout
  title={seo.title}
  description={seo.description}
>
  <Hero />
  <About />
  <Projects />
  <Contact />
</Layout>
