---
import { Image } from "astro:assets"

import { ui, useI18n } from "@/i18n"

import type { CollectionEntry } from "astro:content"

type Props = {
  item: CollectionEntry<"education">
}

const { item } = Astro.props
const { data } = item

const { t } = useI18n(Astro)
const education = t(ui.about.education)
---

<article class="surface-card p-4 sm:p-5">
  <div class="flex items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <Image
        src={data.logo}
        alt={`Logo ${data.academy}`}
        width={40}
        height={40}
        loading="lazy"
        class="academy-logo size-10 shrink-0 bg-zinc-900 object-cover"
      />

      <div class="min-w-0">
        <h3 class="card-title truncate">{data.academy}</h3>
        <p class="card-text truncate">{data.degree}</p>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-end gap-1.5">
      <span class="chip">{data.year}</span>
      <span class="card-meta whitespace-nowrap">
        {data.courses.length} {education.coursesLabel}
      </span>
    </div>
  </div>
</article>
