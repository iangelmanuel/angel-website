---
import { Briefcase, SquareTerminal } from "lucide-react"

import { useI18n } from "@/i18n"
import { getAlternateDesignUrl } from "@/libs/alternate-url"

const { lang, design } = useI18n(Astro)

const href = getAlternateDesignUrl(Astro.url, lang)
const label =
  design === "TERMINAL" ? "Ver presentación formal" : "Ver portafolio terminal"
---

<a
  href={href}
  aria-label={label}
  title={label}
  class="icon-btn mr-0 size-8 transition-transform duration-300 hover:scale-110 sm:size-10"
>
  {
    design === "TERMINAL" ? (
      <Briefcase className="size-4 sm:size-5" />
    ) : (
      <SquareTerminal className="size-4 sm:size-5" />
    )
  }
</a>
