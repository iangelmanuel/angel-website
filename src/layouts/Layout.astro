---
import { ClientRouter } from "astro:transitions"

import ThemeScript from "@/components/seo/ThemeScript.astro"
import { Toaster } from "@/components/ui/sonner"

import BaseHead from "@/components/seo/BaseHead.astro"
import PreloadFont from "@/components/seo/PreloadFont.astro"
import JsonLd from "@/components/seo/JsonLd.astro"
import TopMenu from "@/components/shared/TopMenu.astro"
import MainContent from "@/components/shared/MainContent.astro"
import Footer from "@/components/shared/Footer.astro"

import { useI18n } from "@/i18n"
import {
  faqLd,
  organizationLd,
  professionalServiceLd,
  servicesLd,
  webSiteLd
} from "@/libs/seo"

import "@/styles/portfolio.css"

interface Props {
  title?: string
  description?: string
  image?: string
  imageWidth?: number
  imageHeight?: number
  imageAlt?: string
  keywords?: readonly string[]
  ogType?: "website" | "article"
  publishedTime?: string
  modifiedTime?: string
  tags?: readonly string[]
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  keywords,
  ogType,
  publishedTime,
  modifiedTime,
  tags
} = Astro.props

const { lang, design } = useI18n(Astro)
---

<ThemeScript />

<html
  lang={lang}
  data-design={design}
  class="scroll-smooth"
>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      imageAlt={imageAlt}
      keywords={keywords}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    >
      <PreloadFont
        slot="preloadfonts"
        design={design}
      />
    </BaseHead>

    <JsonLd
      id="ld-organization"
      data={organizationLd(lang)}
    />
    <JsonLd
      id="ld-website"
      data={webSiteLd(lang)}
    />
    <JsonLd
      id="ld-business"
      data={professionalServiceLd()}
    />
    <JsonLd
      id="ld-services"
      data={servicesLd(lang)}
    />
    <JsonLd
      id="ld-faq"
      data={faqLd(lang)}
    />

    <slot name="jsonld" />

    <ClientRouter />
  </head>

  <body>
    <TopMenu />

    <MainContent>
      <slot />
    </MainContent>

    <Toaster
      position="top-right"
      richColors
      duration={3000}
      client:visible
    />

    <Footer />
  </body>
</html>
